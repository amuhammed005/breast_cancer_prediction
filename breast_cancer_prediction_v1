 0.028671\n","1        Random Forest                   0.947909                  0.018138\n","7          Gaussian NB                   0.922044                  0.019645"]},"execution_count":16,"metadata":{},"output_type":"execute_result"}],"source":["def nested_cv_score(base_clf, param_grid, X, y, outer_cv, inner_splits=3):\n","    \"\"\"Score a classifier with nested cross validation.\n","\n","    An inner grid search selects hyperparameters, and the outer loop measures\n","    balanced accuracy on folds that were not used for that selection.\n","\n","    Args:\n","        base_clf: Unfitted pipeline.\n","        param_grid: Hyperparameter grid for ``GridSearchCV``.\n","        X: Feature matrix.\n","        y: Labels.\n","        outer_cv: Outer cross validation splitter.\n","        inner_splits: Number of folds in the inner loop.\n","\n","    Returns:\n","        Array with the balanced accuracy of each outer fold.\n","    \"\"\"\n","    inner_cv = StratifiedKFold(n_splits=inner_splits, shuffle=True, random_state=1)\n","    grid = GridSearchCV(base_clf, param_grid, cv=inner_cv, scoring=\"balanced_accuracy\", n_jobs=-1)\n","    return cross_val_score(grid, X, y, cv=outer_cv, scoring=\"balanced_accuracy\", n_jobs=-1)\n","\n","\n","# Outer folds estimate performance, inner folds select hyperparameters\n","outer_cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n","\n","nested_rows = []\n","for name, clf in make_classifiers().items():\n","    scores = nested_cv_score(clf, param_grids[name], X, y, outer_cv)\n","    nested_rows.append({\"Classifier\": name, \"Tuned Balanced Acc (mean)\": scores.mean(), \"Tuned Balanced Acc (std)\": scores.std()})\n","    print(f\"{name}: {scores.mean():.4f} +/- {scores.std():.4f}\")\n","\n","nested_results = pd.DataFrame(nested_rows).sort_values(\"Tuned Balanced Acc (mean)\", ascending=False)\n","nested_results\n"]},{"cell_type":"code","execution_count":17,"id":"ec561380","metadata":{"execution":{"iopub.execute_input":"