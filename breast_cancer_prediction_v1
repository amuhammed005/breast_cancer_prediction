thness_mean           0.456324\n","dtype: float64\n"]}],"source":["# Skewness of the continuous 'mean' features\n","print(\"Skewness of the 'mean' feature group:\")\n","mean_cols = [c for c in df.columns if c.endswith(\"_mean\")]\n","print(df[mean_cols].skew().sort_values(ascending=False))\n"]},{"cell_type":"markdown","id":"ff725147","metadata":{"papermill":{"duration":0.010625,"end_time":"2026-10-22T11:31:20.396681+00:00","exception":false,"start_time":"2026-10-22T11:31:20.386056+00:00","status":"completed"},"tags":[]},"source":["## Step 4: Feature Matrix and Train/Test Split\n","A stratified 70/30 split is used for the baseline evaluation, the final tuned models and the SHAP analysis. The cross validation steps use the full dataset."]},{"cell_type":"code","execution_count":10,"id":"27f152b2","metadata":{"execution":{"iopub.execute_input":"2026-10-22T11:31:20.417764Z","iopub.status.busy":"2026-10-22T11:31:20.417406Z","iopub.status.idle":"2026-10-22T11:31:20.430234Z","shell.execute_reply":"2026-10-22T11:31:20.429376Z"},"papermill":{"duration":0.025741,"end_time":"2026-10-22T11:31:20.431975+00:00","exception":false,"start_time":"2026-10-22T11:31:20.406234+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["X shape: (569, 30)  y shape: (569,)\n","Train: (398, 30) Test: (171, 30)\n"]}],"source":["# Features and target\n","X = df.drop(columns=[target_col])\n","y = df[target_col]\n","print(\"X shape:\", X.shape, \" y shape:\", y.shape)\n","\n","# Stratified 70/30 split\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X, y, test_size=0.30, random_state=42, stratify=y\n",")\n","print(\"Train:\", X_train.shape, \"Test:\", X_test.shape)\n"]},{"cell_type":"markdown","id":"c0de15b0","metadata":{"papermill":{"duration":0.009714,"end_time":"2026-10-22T11:31:20.45201+00:00","exception":false,"start_time":"2026-10-22T11:31:20.442296+00:00","status":"completed"},"tags":[]},"source":["## Step 5: Classifier Definitions\n","Each model sits in a pipeline with median imputation and standard scaling. Scaling matters on WDBC because the features span very different ranges (`area_mean` runs into the hundreds or thousands while `smoothness_mean` is a small decimal), and distance based models such as SVC would otherwise be dominated by the features with the largest raw values."]},{"cell_type":"code","execution_count":11,"id":"b6c50487","metadata":{"execution":{"iopub.execute_input":"2026-10-22T11:31:20.474462Z","iopub.status.busy":"2026-10-22T11:31:20.474121Z","iopub.status.idle":"2026-10-22T11:31:26.38879Z","shell.execute_reply":"2026-10-22T11:31:26.387594Z"},"papermill":{"duration":5.931475,"end_time":"2026-10-22T11:31:26.393075+00:00","exception":false,"start_time":"2026-10-22T11:31:20.4616+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["8 classifiers built and fitted on the train split.\n"]}],"source":["def build_pipeline(model):\n","    \"\"\"Wrap a model in the shared preprocessing pipeline.\n","\n","    Applies median imputation (a safeguard, since WDBC has no missing values) and\n","    standard scaling before the model. Pandas output keeps the feature names.\n","\n","    Args:\n","        model: Unfitted scikit-learn compatible classifier.\n","\n","    Returns:\n","        ``Pipeline`` with imputer, scaler and model steps.\n","    \"\"\"\n","    pipeline = Pipeline([\n","        (\"imputer\", SimpleImputer(strategy=\"median\")),  # safeguard only, WDBC has no missing values\n","        (\"scaler\", StandardScaler()),\n","        (\"model\", model),\n","    ])\n","    pipeline.set_output(transform=\"pandas\")\n","    return pipeline\n","\n","\n","def make_classifiers():\n","    \"\"\"Create fresh, unfitted pipelines for the eight classifiers.\n","\n","    Returns:\n","        Dict mapping classifier name to its pipeline.\n","    \"\"\"\n","    return {\n","        \"Logistic Regression\": build_pipeline(LogisticRegression(max_iter=1000, random_state=42)),\n","        \"Random Forest\": build_pipeline(RandomForestClassifier(random_state=42)),\n","        \"Extra Trees\": build_pipeline(ExtraTreesClassifier(random_state=42)),\n","        \"XGB\": build_pipeline(XGBClassifier(eval_metric=\"logloss\", random_state=42)),\n","        \"LGBM\": build_pipeline(LGBMClassifier(random_state=42, verbose=-1)),\n","        \"Cat Boost\": build_pipeline(CatBoostClassifier(random_state=42, verbose=0)),\n","        \"SVC\": build_pipeline(SVC(probability=True, random_state=42)),\n","        \"Gaussian NB\": build_pipeline(GaussianNB()),\n","    }\n","\n","\n","# Fit all eight classifiers with default hyperparameters on the training split\n","classifiers_default = make_classifiers()\n","for name, clf in classifiers_default.items():\n","    clf.fit(X_train, y_train)\n","print(\"8 classifiers built and fitted on the train split.\")\n"]},{"cell_type":"markdown","id":"ff02ace2","metadata":{"papermill":{"duration":0.010831,"end_time":"2026-10-22T11:31:26.415258+00:00","exception":false,"start_time":"2026-10-22T11:31:26.404427+00:00","status":"completed"},"tags":[]},"source":["## Step 6: Baseline Evaluation on the Held Out Test Split\n","A single split sanity check with default hyperparameters: classification report, confusion matrices, precision recall curves and ROC curves for the training and test splits."]},{"cell_type":"code","execution_count":12,"id":"1fcb65ed","metadata":{"execution":{"iopub.execute_input":"2026-10-22T11:31:26.440376Z","iopub.status.busy":"2026-10-22T11:31:26.440033Z","iopub.status.idle":"2026-10-22T11:31:31.270905Z","shell.execute_reply":"2026-10-22T11:31:31.269955Z"},"papermill":{"duration":4.847385,"end_time":"2026-10-22T11:31:31.273292+00:00","exception":false,"start_time":"2026-10-22T11:31:26.425907+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","===== Logistic Regression =====\n","              precision    recall  f1-score   sup