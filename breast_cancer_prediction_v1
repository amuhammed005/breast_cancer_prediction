rue)\n","\n","    numeric_cols = [\"Year\", \"Tumor Size (cm)\", \"Inv-Nodes\", \"Metastasis\", \"History\"]\n","    for col in numeric_cols:\n","        df_clinical[col] = pd.to_numeric(df_clinical[col], errors=\"coerce\")\n","\n","    categorical_cols = [\"Breast\", \"Breast Quadrant\"]\n","    for col in categorical_cols:\n","        df_clinical[col] = df_clinical[col].astype(str).str.strip().str.capitalize()\n","    df_clinical = pd.get_dummies(df_clinical, columns=categorical_cols, drop_first=False)\n","\n","    clinical_target = \"Diagnosis Result\"\n","    le_clinical = LabelEncoder()\n","    df_clinical[clinical_target] = le_clinical.fit_transform(df_clinical[clinical_target])\n","\n","    X_clinical = df_clinical.drop(columns=[clinical_target])\n","    y_clinical = df_clinical[clinical_target]\n","\n","    cv_results_clinical, _ = run_cv(make_classifiers(), X_clinical, y_clinical)\n","\n","    rank_wdbc = cv_results_default.set_index(\"Classifier\")[\"Balanced Acc (mean)\"].rank(ascending=False)\n","    rank_clinical = cv_results_clinical.set_index(\"Classifier\")[\"Balanced Acc (mean)\"].rank(ascending=False)\n","\n","    rank_comparison = pd.DataFrame({\n","        \"Rank on WDBC (Primary, 569 patients)\": rank_wdbc,\n","        \"Rank on Clinical Dataset (External, ~206 patients)\": rank_clinical,\n","    }).sort_values(\"Rank on WDBC (Primary, 569 patients)\")\n","    rank_comparison[\"Rank difference\"] = (\n","        rank_comparison[\"Rank on WDBC (Primary, 569 patients)\"]\n","        - rank_comparison[\"Rank on Clinical Dataset (External, ~206 patients)\"]\n","    ).abs()\n","\n","    print(rank_comparison)\n","\n","except FileNotFoundError:\n","    print(\"Clinical dataset not attached to this notebook - skipping this optional check.\")\n"]},{"cell_type":"markdown","id":"81bf6649","metadata":{"papermill":{"duration":0.019154,"end_time":"2026-10-22T11:43:18.75524+00:00","exception":false,"start_time":"2026-10-22T11:43:18.736086+00:00","status":"completed"},"tags":[]},"source":["## Step 12: SHAP Based Feature Selection\n","SHAP values are computed for every classifier (`TreeExplainer` for tree based models and `KernelExplainer` for the rest) and averaged into one overall feature ranking. The classifiers are then re evaluated with cross validation on the top 30, 15, 10, 5 and 3 features."]},{"cell_type":"code","execution_count":22,"id":"5cbb0b14","metadata":{"execution":{"iopub.execute_input":"2026-10-22T11:43:18.795677Z","iopub.status.busy":"2026-10-22T11:43:18.795374Z","iopub.status.idle":"2026-10-22T11:44:12.815266Z","shell.execute_reply":"2026-10-22T11:44:12.814361Z"},"papermill":{"duration":54.043013,"end_time":"2026-10-22T11:44:12.817323+00:00","exception":false,"start_time":"2026-10-22T11:43:18.77431+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"bb53a645cf6948649df1198d9a8fc1b3","version_major":2,"version_minor":0},"text/plain":["  0%|          | 0/398 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.12/dist-packages/shap/explainers/_tree.py:620: UserWarning: LightGBM binary classifier with TreeExplainer shap values output has changed to a list of ndarray\n","  warnings.warn(\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"9fcdee2d32cf4dbfba3b60f4c7806b21","version_major":2,"version_minor":0},"text/plain":["  0%|          | 0/398 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"54894aab17ce40ee86c444fac403dd4c","version_major":2,"version_minor":0},"text/plain":["  0%|          | 0/398 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Average SHAP importance across all 8 classifiers (top 15):\n","perimeter_worst         0.510112\n","concave points_worst    0.400299\n","concave points_mean     0.352611\n","concavity_worst         0.285791\n","texture_worst           0.274011\n","radius_worst            0.268153\n","area_se                 0.264906\n","area_worst              0.212694\n","texture_mean            0.195519\n","symmetry_worst          0.112775\n","compactness_se          0.093614\n","smoothness_worst        0.093088\n","area_mean               0.092416\n","smoothness_mean         0.091664\n","compactness_mean        0.066967\n","dtype: float64\n"]}],"source":["def get_shap_ranking(name, clf, X_data):\n","    \"\"\"Rank features by mean absolute SHAP value for one classifier.\n","\n","    Uses ``TreeExplainer`` for tree based models and ``KernelExplainer`` for the\n","    rest. SHAP values are taken for the malignant class.\n","\n","    Args:\n","        name: Classifier name, used to choose the explainer.\n","        clf: Fitted pipeline.\n","        X_data: Data to explain, before preprocessing.\n","\n","    Returns:\n","        Series of mean absolute SHAP values, sorted in descending order.\n","    \"\"\"\n","    preprocessing = clf[:-1]\n","    X_transformed = preprocessing.transform(X_data)\n","    model = clf.named_steps[\"model\"]\n","\n","    tree_based_names = (\"Forest\", \"Extra Trees\", \"XGB\", \"LGBM\", \"Cat Boost\")\n","    if any(key in name for key in tree_based_names):\n","        explainer = shap.TreeExplainer(model)\n","        shap_values = explainer.shap_values(X_transformed)\n","        if isinstance(shap_values, list):\n","            shap_values = shap_values[1]\n","        elif isinstance(shap_values, np.ndarray) and shap_values.ndim == 3:\n","            shap_values = shap_values[:, :, 1]\n","    else:\n","        background = shap.sample(X_transformed, min(100, len(X_transformed)), random_state=42)\n","        explainer = shap.KernelExplainer(model.predict_proba, background)\n","        shap_values = explainer.shap_values(X_transformed, nsamples=100)\n","        if isinstance(shap_values, list):\n","            shap_values = shap_values[1]\n","        elif isinstance(shap_values, np.ndarray) and shap_values.ndim == 3:\n","            shap_values = shap_values[:, :, 1]\n","\n","    mean_abs_shap = np.abs(shap_values).mean(axis=0)\n","    return pd.Series(mean_abs_shap, index=X_transformed.columns).sort_values(ascending=False)\n","\n","\n","# Fit on the training split and average the SHAP rankings across all classifiers\n","classifiers_for_shap = make_classifiers()\n","for name, clf in classifiers_for_shap.items():\n","    clf.fit(X_train, y_train)\n","\n","rankings = {name: get_shap_ranking(name, clf, X_train) for name, clf in classifiers_for_shap.items()}\n","overall_ranking = pd.DataFrame(rankings).mean(axis=1).sort_values(ascending=False)\n","print(\"Average SHAP importance across all 8 classifiers (top 15):\")\n","print(overall_ranking.head(15))\n"]},{"cell_type":"code","execution_count":23,"id":"4daacce3","metadata":{"execution":{"iopub.execute_input":"2026-10-22T11:44:12.85954Z","iopub.status.busy":"2026-10-22T11:44:12.858707Z","iopub.status.idle":"2026-10-22T11:44:13.271133Z","shell.execute_reply":"2026-10-22T11:44:13.270179Z"},"papermill":{"duration":0.436359,"end_time":"2026-10-22T11:44:13.273736+00:00","exception":false,"start_time":"2026-10-22T11:44:12.837377+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 800x800 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Overall feature importance\n","plt.figure(figsize=(8, 8))\n","overall_ranking.plot(kind=\"barh\")\n","plt.gca().invert_yaxis()\n","plt.xlabel(\"Mean |SHAP value| averaged across all 8 classifiers\")\n","plt.title(\"Overall Feature Importance (WDBC, all 30 features)\")\n","plt.tight_layout()\n","plt.show()\n"]},{"cell_type":"code","execution_count":24,"id":"685b0122","metadata":{"execution":{"iopub.execute_input":"2026-10-22T11:44:13.320929Z","iopub.status.busy":"2026-10-22T11:44:13.32054Z","iopub.status.idle":"2026-10-22T1