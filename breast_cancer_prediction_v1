 validation splitter.\n","        scoring: Dict of scorers accepted by ``cross_validate``.\n","\n","    Returns:\n","        Tuple ``(results, raw_scores)``. ``results`` is a DataFrame of mean scores\n","        sorted by balanced accuracy, and ``raw_scores`` maps each classifier name\n","        to its per fold balanced accuracy.\n","    \"\"\"\n","    rows = []\n","    raw_scores = {}\n","    for name, clf in classifiers.items():\n","        result = cross_validate(clf, X, y, cv=cv, scoring=scoring, n_jobs=-1)\n","        raw_scores[name] = result[\"test_balanced_accuracy\"]\n","        rows.append({\n","            \"Classifier\": name,\n","            \"Balanced Acc (mean)\": result[\"test_balanced_accuracy\"].mean(),\n","            \"Balanced Acc (std)\": result[\"test_balanced_accuracy\"].std(),\n","            \"Recall (mean)\": result[\"test_recall\"].mean(),\n","            \"Precision (mean)\": result[\"test_precision\"].mean(),\n","            \"F1 (mean)\": result[\"test_f1\"].mean(),\n","            \"ROC-AUC (mean)\": result[\"test_roc_auc\"].mean(),\n","        })\n","    return pd.DataFrame(rows).sort_values(\"Balanced Acc (mean)\", ascending=False), raw_scores\n","\n","\n","cv_results_default, cv_raw_default = run_cv(make_classifiers(), X, y)\n","cv_results_default\n"]},{"cell_type":"code","execution_count":14,"id":"41fb6307","metadata":{"execution":{"iopub.execute_input":"2026-10-22T11:32:02.415514Z","iopub.status.busy":"2026-10-22T11:32:02.415216Z","iopub.status.idle":"2026-10-22T11:32:02.589793Z","shell.execute_reply":"2026-10-22T11:32:02.588878Z"},"papermill":{"duration":0.193824,"end_time":"2026-10-22T11:32:02.591579+00:00","exception":false,"start_time":"2026-10-22T11:32:02.397755+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1000x500 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Mean and standard deviation of balanced accuracy per classifier\n","plt.figure